{
  "name": "mine-agent-sdk",
  "version": "0.1.0",
  "description": "A production-oriented TypeScript AI agent SDK with composable providers, tools, memory, guardrails, tracing, handoffs, and plugins.",
  "license": "MIT",
  "author": "Abhay Maheta",
  "type": "commonjs",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sampleritzgod/mine-agent-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/sampleritzgod/mine-agent-sdk#readme",
  "bugs": {
    "url": "https://github.com/sampleritzgod/mine-agent-sdk/issues"
  },
  "keywords": [
    "agent",
    "agents",
    "ai",
    "llm",
    "sdk",
    "typescript",
    "openai",
    "anthropic",
    "gemini",
    "tools",
    "orchestration"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./providers/openai": {
      "import": {
        "types": "./dist/providers/openai-provider.d.mts",
        "default": "./dist/providers/openai-provider.mjs"
      },
      "require": {
        "types": "./dist/providers/openai-provider.d.ts",
        "default": "./dist/providers/openai-provider.js"
      }
    },
    "./providers/anthropic": {
      "import": {
        "types": "./dist/providers/anthropic-provider.d.mts",
        "default": "./dist/providers/anthropic-provider.mjs"
      },
      "require": {
        "types": "./dist/providers/anthropic-provider.d.ts",
        "default": "./dist/providers/anthropic-provider.js"
      }
    },
    "./providers/gemini": {
      "import": {
        "types": "./dist/providers/gemini-provider.d.mts",
        "default": "./dist/providers/gemini-provider.mjs"
      },
      "require": {
        "types": "./dist/providers/gemini-provider.d.ts",
        "default": "./dist/providers/gemini-provider.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --import tsx --test test/unit/*.test.ts test/integration/*.test.ts test/failure/*.test.ts test/edge/*.test.ts test/concurrency/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --config ../../eslint.config.mjs --max-warnings 0",
    "check:exports": "npx publint . && npx @arethetypeswrong/cli --pack . --profile node16",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@google/genai": "^2.15.0",
    "@types/node": "^22.13.0",
    "openai": "^6.49.0",
    "publint": "^0.3.22",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@google/genai": "^2.0.0",
    "openai": "^4.20.0 || ^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
