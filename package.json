{
  "name": "mine-agent-sdk-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for mine-agent-sdk — a production-oriented TypeScript agent SDK.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "pnpm --filter mine-agent-sdk test:watch",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,css,yml,yaml}\"",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean && rm -rf node_modules",
    "web": "pnpm --filter web dev",
    "example:basic": "pnpm --filter example-basic start",
    "example:tool-use": "pnpm --filter example-tool-use start",
    "example:streaming": "pnpm --filter example-streaming start",
    "example:handoff": "pnpm --filter example-multi-agent-handoff start",
    "example:openai": "pnpm --filter example-openai-provider start",
    "example:anthropic": "pnpm --filter example-anthropic-provider start",
    "example:gemini": "pnpm --filter example-gemini-provider start",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=mine-agent-sdk && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0"
  }
}
