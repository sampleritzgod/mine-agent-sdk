{
  "name": "mine-agent-sdk",
  "version": "0.1.0",
  "description": "A production-oriented TypeScript AI agent SDK with composable providers, tools, memory, guardrails, tracing, handoffs, and plugins.",
  "license": "MIT",
  "author": "Abhay Maheta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sampleritzgod/mine-agent-sdk.git"
  },
  "homepage": "https://github.com/sampleritzgod/mine-agent-sdk#readme",
  "bugs": {
    "url": "https://github.com/sampleritzgod/mine-agent-sdk/issues"
  },
  "keywords": [
    "agent",
    "agents",
    "ai",
    "llm",
    "sdk",
    "typescript",
    "openai",
    "anthropic",
    "tools",
    "orchestration"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsup",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts tests/failure/*.test.ts tests/edge/*.test.ts tests/concurrency/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "example:basic": "tsx examples/basic.ts",
    "example:tool-use": "tsx examples/tool-use.ts",
    "example:streaming": "tsx examples/streaming.ts",
    "example:handoff": "tsx examples/multi-agent-handoff.ts"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "openai": "^6.49.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
